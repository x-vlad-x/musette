Subject: Include the native GTK interface in the build
Date: 2026-11-27
Upstream status: Local only

Include the GTK module and expose the Compose translations it reuses.

diff --git a/composeApp/build.gradle.kts b/composeApp/build.gradle.kts
index 664bfa5a..a842a7fc 100644
--- a/composeApp/build.gradle.kts
+++ b/composeApp/build.gradle.kts
@@ -35,6 +35,8 @@ plugins {
 // Force it to `always` so `Res` is generated for this app module.
 compose.resources {
     generateResClass = always
+    // GTK front-end patch: ../gtk-ui shows SimpMusic's own translated strings.
+    publicResClass = true
 }
 
 kotlin {
diff --git a/settings.gradle.kts b/settings.gradle.kts
index a389d077..571df7e6 100644
--- a/settings.gradle.kts
+++ b/settings.gradle.kts
@@ -65,6 +65,10 @@ include(
     ":loginSync",
 )
 
+// GTK front-end patch: the native GNOME interface, kept outside this checkout (see ../gtk-ui).
+include(":gtkApp")
+project(":gtkApp").projectDir = System.getenv("GTK_UI_DIR")?.let(::File) ?: File(rootDir, "../gtk-ui")
+
 // core modules
 project(":common").projectDir = File(coreDir, "common")
 project(":data").projectDir = File(coreDir, "data")

#!/bin/sh
# SimpMusic (GTK) launcher.
APPDIR="$(dirname "$(readlink -f "$0")")"
# native/ holds a stub libsixel.so.1 that replaces the one libmpv links (see sixel-stub/sixel_stub.c).
export LD_LIBRARY_PATH="$APPDIR/native${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MALLOC_ARENA_MAX=2
# libmpv refuses to start under a non-C numeric locale (see forceCNumericLocale in Main.kt)
export LC_NUMERIC=C
# WebKit's sandbox hides /android (the libhybris GPU driver) -> blank sign-in page; also set in Main.kt
[ -d /android/system ] && export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
# Account, history and settings live in home/, apart from any other SimpMusic installation.
mkdir -p "$APPDIR/home"
exec "$APPDIR/jre/bin/java" \
  -Xmx512m \
  --enable-native-access=ALL-UNNAMED \
  -Duser.home="$APPDIR/home" \
  -XX:ErrorFile="$APPDIR/hs_err_pid%p.log" \
  -cp "$APPDIR/lib/gtkApp-jvm.jar:$APPDIR/lib/*" \
  io.github.x_vlad_x.simpmusicgtk.MainKt "$@" >"$APPDIR/run.log" 2>&1

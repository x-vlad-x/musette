#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
umask 077

app_dir="$(dirname "$(readlink -f "$0")")"
main_class=io.github.x_vlad_x.musette.MainKt
classpath="$app_dir/lib/gtkApp-jvm.jar:$app_dir/lib/*"
if [ "$#" -eq 1 ] && [ "$1" = --version ]; then
  exec "$app_dir/jre/bin/java" -cp "$classpath" "$main_class" "$@"
fi
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
data_dir="$data_home/musette"
cache_dir="$cache_home/musette"
legacy_home="$HOME/.local/share/simpmusic-gtk/home"

# Keep the old profile usable until its installation is retired.
if [ ! -e "$data_dir" ] && [ -d "$legacy_home" ]; then
  mkdir -p "$data_home"
  staging="$(mktemp -d "$data_home/.musette.XXXXXX")"
  trap 'rm -rf -- "$staging"' EXIT
  cp -a "$legacy_home/." "$staging/"
  mv -T --no-clobber -- "$staging" "$data_dir"
  rm -rf -- "$staging"
  trap - EXIT
fi
mkdir -p "$data_dir" "$cache_dir"

export LD_LIBRARY_PATH="$app_dir/native${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MALLOC_ARENA_MAX=2
export LC_NUMERIC=C
# WebKit's sandbox hides the libhybris driver under /android on FuriOS.
if [ -d /android/system ]; then
  export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
fi

exec "$app_dir/jre/bin/java" \
  -Xmx512m \
  --enable-native-access=ALL-UNNAMED \
  -Duser.home="$data_dir" \
  -XX:ErrorFile="$cache_dir/hs_err_pid%p.log" \
  -cp "$classpath" "$main_class" "$@" >"$cache_dir/run.log" 2>&1
